POSTGRES_USER=contract_review
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=contract_review

AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PATH=/contract-review

THINKPARK_SSO_ENABLED=true
THINKPARK_API_URL=https://ai.thinkpark.com.cn
THINKPARK_KNOWLEDGE_GATEWAY_URL=https://ai.thinkpark.com.cn/api/internal/contract-review/knowledge/search
THINKPARK_STORAGE_GATEWAY_URL=https://ai.thinkpark.com.cn/api/internal/contract-review/storage/mirror
THINKPARK_INTEGRATION_KEY=replace-with-the-same-server-only-integration-key
THINKPARK_STORAGE_REQUIRED=true

APP_HOST=https://ai.thinkpark.com.cn/contract-review
BACKEND_URL_FOR_DOCKER=https://ai.thinkpark.com.cn/contract-review
ONLYOFFICE_URL=https://ai.thinkpark.com.cn/onlyoffice
ONLYOFFICE_PUBLIC_URL=/onlyoffice/
ONLYOFFICE_JWT_SECRET=use-the-existing-thinkpark-onlyoffice-secret

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 完整合同审查允许等待思库推理模型返回，但不重复发起昂贵的全量审查。
REVIEW_LLM_TIMEOUT_MS=300000
REVIEW_LLM_MAX_RETRIES=0
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Optional build-time Debian mirror host for mainland China deployments.
# DEBIAN_MIRROR_HOST=http://mirrors.aliyun.com
# Optional existing PostgreSQL 16-compatible image for offline/slow registries.
# POSTGRES_IMAGE=pgvector/pgvector:pg16
